{
  "name": "agent-ops-core",
  "version": "0.0.0",
  "description": "Shared operational machinery for AI decisioning applications: evaluation, audit, approval, telemetry, guardrails.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./approval": {
      "types": "./dist/approval/index.d.ts",
      "default": "./dist/approval/index.js"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "default": "./dist/evals/index.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "default": "./dist/guardrails/index.js"
    },
    "./alerts": {
      "types": "./dist/alerts/index.d.ts",
      "default": "./dist/alerts/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "publishConfig": {
    "access": "public"
  }
}
